[Unit]
Description=PipeWire Network Receiver
After=pipewire-pulse.service
Requires=pipewire-pulse.service
PartOf=pipewire-pulse.service

[Service]
Type=simple
ExecStart=/usr/bin/pipewire-network-receiver
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=pipewire-pulse.service

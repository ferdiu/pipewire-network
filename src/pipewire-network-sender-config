#!/bin/bash
# pipewire-network-sender-config
#
# Configuration management tool for pipewire-network-sender.
# Manages named configurations in ~/.config/pipewire-network/sender.json
# and controls the corresponding systemd user services.
#
# Commands:
#   list                        List available configurations
#   show <name>                 Show a specific configuration
#   validate <name>             Validate a configuration
#   enable <name>               Enable and start a named config via systemd
#   disable <name>              Stop and disable a named config
#   status [name]               Show service status
#   create-sample               Create a sample config file

set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/pipewire-network"
CONFIG_FILE="$CONFIG_DIR/sender.json"
SYSTEM_CONFIG="/etc/pipewire-network/sender.json"

# ── helpers ──────────────────────────────────────────────────────────────────

die() { echo "Error: $*" >&2; exit 1; }

require_jq() {
    command -v jq >/dev/null 2>&1 || die "'jq' is required but not installed. Install it with your package manager."
}

effective_config() {
    if [[ -f "$CONFIG_FILE" ]]; then echo "$CONFIG_FILE"
    elif [[ -f "$SYSTEM_CONFIG" ]]; then echo "$SYSTEM_CONFIG"
    else echo ""
    fi
}

# ── commands ──────────────────────────────────────────────────────────────────

cmd_list() {
    require_jq
    local cfg; cfg="$(effective_config)"
    [[ -z "$cfg" ]] && { echo "No configuration file found."; echo "Run: $(basename "$0") create-sample"; exit 0; }
    echo "Available configurations in $cfg:"
    jq -r 'keys[]' "$cfg" | while read -r name; do
        local n_streams
        n_streams=$(jq -r --arg n "$name" '.[$n].streams | length' "$cfg")
        local active=""
        if systemctl --user is-active --quiet "pipewire-network-sender@${name}.service" 2>/dev/null; then
            active=" [running]"
        fi
        echo "  - $name  ($n_streams stream(s))$active"
    done
}

cmd_show() {
    require_jq
    local name="${1:-}"
    [[ -z "$name" ]] && die "Usage: $(basename "$0") show <name>"
    local cfg; cfg="$(effective_config)"
    [[ -z "$cfg" ]] && die "No configuration file found."
    jq -r --arg n "$name" '.[$n] // error("not found")' "$cfg" || die "Config '$name' not found"
}

cmd_validate() {
    require_jq
    local name="${1:-}"
    [[ -z "$name" ]] && die "Usage: $(basename "$0") validate <name>"
    local cfg; cfg="$(effective_config)"
    [[ -z "$cfg" ]] && die "No configuration file found."

    local obj; obj=$(jq -r --arg n "$name" '.[$n] // empty' "$cfg")
    [[ -z "$obj" ]] && die "Config '$name' not found"

    local errors=0
    local n_streams; n_streams=$(echo "$obj" | jq '.streams | length')
    if [[ "$n_streams" -eq 0 ]]; then echo "  WARNING: no streams defined"; ((errors++)); fi

    echo "$obj" | jq -c '.streams[]' | while IFS= read -r s; do
        local addr; addr=$(echo "$s" | jq -r '.address // empty')
        local port; port=$(echo "$s" | jq -r '.port // empty')
        [[ -z "$addr" ]] && { echo "  ERROR: stream missing 'address'"; ((errors++)); }
        [[ -z "$port" ]] && { echo "  ERROR: stream missing 'port'"; ((errors++)); }
        if [[ -n "$port" ]] && ! [[ "$port" =~ ^[0-9]+$ ]] || [[ "$port" -lt 1 || "$port" -gt 65535 ]]; then
            echo "  ERROR: invalid port '$port'"; ((errors++))
        fi
    done

    if [[ "$errors" -eq 0 ]]; then echo "Config '$name': OK ($n_streams stream(s))"; fi
    return "$errors"
}

cmd_enable() {
    local name="${1:-}"
    [[ -z "$name" ]] && die "Usage: $(basename "$0") enable <name>"
    echo "Enabling pipewire-network-sender@${name}.service..."
    systemctl --user enable --now "pipewire-network-sender@${name}.service"
    echo "Done. Status:"
    systemctl --user status "pipewire-network-sender@${name}.service" --no-pager || true
}

cmd_disable() {
    local name="${1:-}"
    [[ -z "$name" ]] && die "Usage: $(basename "$0") disable <name>"
    echo "Disabling pipewire-network-sender@${name}.service..."
    systemctl --user disable --now "pipewire-network-sender@${name}.service" || true
    echo "Done."
}

cmd_status() {
    local name="${1:-}"
    if [[ -n "$name" ]]; then
        systemctl --user status "pipewire-network-sender@${name}.service" --no-pager || true
    else
        echo "All pipewire-network-sender services:"
        systemctl --user list-units 'pipewire-network-sender*' --no-pager || true
    fi
}

cmd_create_sample() {
    if [[ -f "$CONFIG_FILE" ]]; then
        echo "Config file already exists: $CONFIG_FILE"
        echo "Edit it directly or remove it first."
        exit 0
    fi
    mkdir -p "$CONFIG_DIR"
    cat > "$CONFIG_FILE" << 'JSON'
{
  "default": {
    "streams": [
      {
        "address": "192.168.1.2",
        "port": 9875
      }
    ],
    "auto_connect": true,
    "retry_interval": 10,
    "max_retries": -1
  },
  "living-room": {
    "streams": [
      {
        "address": "192.168.1.3",
        "port": 9875
      }
    ],
    "auto_connect": true,
    "retry_interval": 10,
    "max_retries": 3
  }
}
JSON
    echo "Sample configuration created: $CONFIG_FILE"
    echo "Edit it to match your network setup, then run:"
    echo "  $(basename "$0") enable default"
}

# ── dispatch ──────────────────────────────────────────────────────────────────

usage() {
    cat << EOF
Usage: $(basename "$0") <command> [args]

Commands:
  list                List all available named configurations
  show <name>         Print a specific configuration as JSON
  validate <name>     Validate a configuration for common errors
  enable <name>       Enable and start the systemd service for <name>
  disable <name>      Stop and disable the systemd service for <name>
  status [name]       Show status of running sender service(s)
  create-sample       Create a sample sender.json configuration file

Config file: $CONFIG_FILE
EOF
}

case "${1:-}" in
    list)          cmd_list ;;
    show)          cmd_show "${2:-}" ;;
    validate)      cmd_validate "${2:-}" ;;
    enable)        cmd_enable "${2:-}" ;;
    disable)       cmd_disable "${2:-}" ;;
    status)        cmd_status "${2:-}" ;;
    create-sample) cmd_create_sample ;;
    ""|--help|-h)  usage ;;
    *)             echo "Unknown command: $1" >&2; usage >&2; exit 1 ;;
esac

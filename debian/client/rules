#!/usr/bin/make -f
%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_build:
	# Nothing to build

override_dh_auto_install:
	# Install Python script
	install -D -m 755 src/pipewire-network-sender debian/pipewire-network-sender/usr/bin/pipewire-network-sender

	# Install configuration manager script
	install -D -m 755 src/pipewire-network-sender-config debian/pipewire-network-sender/usr/bin/pipewire-network-sender-config

	# Install systemd user services (both template and default)
	install -D -m 644 systemd/pipewire-network-sender@.service debian/pipewire-network-sender/usr/lib/systemd/user/pipewire-network-sender@.service
	install -D -m 644 systemd/pipewire-network-sender.service debian/pipewire-network-sender/usr/lib/systemd/user/pipewire-network-sender.service

	# Install default configuration
	install -D -m 644 config/sender.json debian/pipewire-network-sender/etc/pipewire-network/sender.json

#!/bin/bash
set -e

case "$1" in
    configure)
        echo "PipeWire Network Sender installed successfully!"
        echo ""
        echo "Configuration Management:"
        echo "1. Create/edit configurations:"
        echo "   pipewire-network-sender-config create-sample"
        echo "   pipewire-network-sender-config list"
        echo ""
        echo "2. Enable specific configurations:"
        echo "   pipewire-network-sender-config enable default"
        echo "   pipewire-network-sender-config enable living-room"
        echo ""
        echo "3. Using systemd directly:"
        echo "   systemctl --user enable pipewire-network-sender@living-room.service"
        echo "   systemctl --user start pipewire-network-sender@living-room.service"
        echo ""
        echo "4. Check service status:"
        echo "   pipewire-network-sender-config status"
        ;;
esac

#DEBHELPER#
exit 0

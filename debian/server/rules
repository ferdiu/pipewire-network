#!/usr/bin/make -f
%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_build:
	# Nothing to build

override_dh_auto_install:
	# Install Python script
	install -D -m 755 src/pipewire-network-receiver debian/pipewire-network-receiver/usr/bin/pipewire-network-receiver

	# Install systemd user service
	install -D -m 644 systemd/pipewire-network-receiver.service debian/pipewire-network-receiver/usr/lib/systemd/user/pipewire-network-receiver.service

	# Install firewalld service definition
	install -D -m 644 firewalld/pipewire-network.xml debian/pipewire-network-receiver/usr/lib/firewalld/services/pipewire-network.xml

	# Install default configuration
	install -D -m 644 config/receiver.json debian/pipewire-network-receiver/etc/pipewire-network/receiver.json
